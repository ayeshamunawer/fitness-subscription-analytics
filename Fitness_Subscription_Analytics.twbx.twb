      <column caption='Customer Start Date' datatype='date' name='[Calculation_0525683324461056]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID] : MIN([Transaction_Date]) }' />
      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_0525683324579841]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_0525683324461056])' />
      </column>
      <column caption='Customer Start Month' datatype='datetime' name='[Calculation_0525684657934341]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, { FIXED [Customer_ID] : MIN([Transaction_Date]) })' />
      </column>
      <column caption='Months Since Start' datatype='integer' name='[Calculation_0525684658913289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;month&apos;,&#10;    [Calculation_0525684657934341],&#10;    [Transaction_Date]&#10;)' />
      </column>
      <column caption='Cohort Size' datatype='integer' name='[Calculation_0525684662337550]' role='measure' type='quantitative'>
